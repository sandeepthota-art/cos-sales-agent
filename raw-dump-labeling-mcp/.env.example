MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cos_sales

# SALES_AGENT_MONGODB_* takes priority over MONGODB_* when both are set --
# see app/config.py. Use this pair if this machine also runs some other,
# unrelated system that sets generic MONGODB_URI/MONGODB_DATABASE.
# SALES_AGENT_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# SALES_AGENT_MONGODB_DATABASE=<your-db-name>

# The mailbox this agent reads on behalf of -- a new ingested email FROM this
# address, landing in a thread with an open "Needs reply*" item, closes that
# item out automatically (see app/tools.py::ingest_raw_email_only).
AGENT_EMAIL=you@yourdomain.example

LOG_LEVEL=INFO
