APP_ENV=development

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cos_sales

# Optional: if this machine has generic MONGODB_URI/MONGODB_DATABASE set as system-wide
# environment variables for some other application, uncomment these -- they take priority
# over the generic names above, since OS-level env vars always outrank this .env file.
# SALES_AGENT_MONGODB_URI=mongodb://localhost:27017
# SALES_AGENT_MONGODB_DATABASE=cos_sales

EMAIL_LIMIT=50

EMAIL_PROVIDER=demo
CALENDAR_PROVIDER=mock
LLM_PROVIDER=mock

LLM_API_KEY=
LLM_MODEL=
# Optional: only for the "openai" provider targeting a non-OpenAI, OpenAI-compatible
# endpoint (e.g. Groq). Leave unset to use api.openai.com.
# LLM_BASE_URL=

# The authenticated user's own mailbox. Identifies which side of a thread is "us" so the
# pipeline never drafts a reply addressed to our own sales rep for our own outbound email.
AGENT_EMAIL=ashok@oursalesagent-demo.example

MCP_EMAIL_ENABLED=false
MCP_CALENDAR_ENABLED=false

SIMULATION_MODE=true

TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO

DEMO_SEED=42

# Folder-watching scheduler (python -m app.scheduler) -- polls this folder for new
# Gmail-export JSON files (the same shape --mode=file already ingests) every
# INGESTION_INTERVAL_MINUTES and runs each through the full LLM+entity pipeline.
INGESTION_FOLDER=data/inbox
INGESTION_INTERVAL_MINUTES=5

# Which Source the ingestion scheduler polls: "folder" (default) or "gmail" (currently
# blocked -- no real MCP client exists to inject; see app/providers/source/live_gmail.py)
EMAIL_SOURCE=folder

# Reminder scheduler (python -m app.reminders) -- separate from ingestion above. Polls
# personal_items every REMINDER_INTERVAL_MINUTES for items whose date_or_deadline has
# passed and status is still "open"; triggers a reminder (logged) and marks the item
# "reminded" so it's never delivered twice.
REMINDER_INTERVAL_MINUTES=5

# Knowledge projector (python -m app.knowledge_projector) -- writes a deterministic
# Markdown projection of MongoDB knowledge here. MongoDB remains the source of truth.
KNOWLEDGE_DIR=data/knowledge

# --- Optional: only for running the MCP server over HTTP (e.g. on Render) ----------
# Read directly by app/mcp/server.py, not by app.config.Settings. Leave unset to run
# the MCP server over stdio (the default, used by a local Claude Desktop connection).
# MCP_TRANSPORT=streamable-http
# MCP_AUTH_TOKEN=<a long random secret -- required whenever MCP_TRANSPORT=streamable-http>
# PORT=8000
