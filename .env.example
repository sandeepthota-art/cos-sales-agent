# Copy to .env and fill in real values. Never commit the real .env.

# Local MongoDB (used when SALES_AGENT_MONGODB_* below is unset/commented out)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cos_sales

# MongoDB Atlas (locked decision: this is the real storage target).
# SALES_AGENT_MONGODB_URI takes priority over MONGODB_URI when set.
# SALES_AGENT_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app>
# SALES_AGENT_MONGODB_DATABASE=<database-name>

# The mailbox this agent reads/sends on behalf of -- needed to detect our
# OWN reply landing in a thread so an earlier "Needs reply*" item can be
# closed out automatically.
AGENT_EMAIL=you@example.com

LOG_LEVEL=INFO
